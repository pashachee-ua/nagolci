# Copy only needed values into local ignored files or Cloudflare secrets.
EDITOR_EMAILS=REPLACE_WITH_COMMA_SEPARATED_EDITOR_EMAILS
ADMIN_ORIGIN=https://REPLACE_WITH_ADMIN_DOMAIN
PUBLIC_ORIGIN=https://REPLACE_WITH_PAGES_PROJECT.pages.dev
ACCESS_ISSUER=https://REPLACE_WITH_TEAM.cloudflareaccess.com
ACCESS_AUD=REPLACE_WITH_EDITOR_ACCESS_APPLICATION_AUD
PAGES_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
PAGES_PROJECT=REPLACE_WITH_PAGES_PROJECT
# Worker secrets (do not put in wrangler vars, Git, or VITE_*):
BUILD_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_BUILD_TOKEN
PAGES_API_TOKEN=REPLACE_WITH_SCOPED_PAGES_READ_TOKEN
PAGES_DEPLOY_HOOK=REPLACE_WITH_PRODUCTION_BRANCH_DEPLOY_HOOK
# Pages production build secrets only:
BUILD_ORIGIN=https://REPLACE_WITH_ADMIN_DOMAIN
CF_ACCESS_CLIENT_ID=REPLACE_WITH_BUILD_SERVICE_TOKEN_ID
CF_ACCESS_CLIENT_SECRET=REPLACE_WITH_BUILD_SERVICE_TOKEN_SECRET
# CF_PAGES_URL is supplied by Cloudflare during a Pages build.
