{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nagolci-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist/admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagolci-content",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "REPLACE_WITH_R2_BUCKET"
    }
  ],
  "vars": {
    "ADMIN_ORIGIN": "https://REPLACE_WITH_ADMIN_DOMAIN",
    "ACCESS_ISSUER": "https://REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUD",
    "EDITOR_EMAILS": "REPLACE_WITH_EDITOR_EMAILS",
    "PUBLIC_ORIGIN": "https://REPLACE_WITH_PUBLIC_ORIGIN",
    "PAGES_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    "PAGES_PROJECT": "REPLACE_WITH_PAGES_PROJECT"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "REPLACE_WITH_ADMIN_DOMAIN",
      "custom_domain": true
    }
  ]
}
